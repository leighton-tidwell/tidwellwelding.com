{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidwellwelding",
  "main": ".open-next/worker.js",
  // SEO P0-1: no indexable duplicate hosts — the only public host is the apex custom domain.
  "workers_dev": false,
  "preview_urls": false,
  // Mirrors the dashboard's Observability settings so deploys stay consistent.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "tidwellwelding.com", "custom_domain": true },
    { "pattern": "www.tidwellwelding.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tidwellwelding"
    }
  ]
}
