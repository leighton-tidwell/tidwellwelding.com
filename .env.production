# Build-time public values. Both are embedded in the client bundle by design —
# the browser needs them — so they are safe in a public repo. Secrets live in
# Convex env vars (npx convex env set) and Wrangler secrets, never here.
#
# NEXT_PUBLIC_CONVEX_URL is normally injected by `npx convex deploy --cmd`;
# this value is the fallback so a plain `pnpm build` still targets prod.
NEXT_PUBLIC_CONVEX_URL=https://resilient-mockingbird-325.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://resilient-mockingbird-325.convex.site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEU7WR2vQ1jwPD_O
