# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values live here —
# they are safe to expose to the browser.

# Convex deployment URL (printed by `npx convex dev`, e.g. https://<slug>.convex.cloud)
#
# FOOTGUN: Next loads .env.local at HIGHER precedence than .env.production, and
# inlines NEXT_PUBLIC_* at BUILD time. A production build run on this machine
# would therefore bake YOUR dev deployment into the live bundle — which is
# exactly how the live site once ended up reading the dev database. Deploy only
# via .github/workflows/deploy-production.yml; scripts/assert-production-convex-url.mjs
# now fails the build instead of shipping the wrong URL.
NEXT_PUBLIC_CONVEX_URL=

# Cloudflare Turnstile site key (public)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side secrets do NOT go in this file or anywhere in the Next app.
# They live in the Convex deployment, set via:
#   npx convex env set RESEND_API_KEY <value>
#   npx convex env set ANTHROPIC_API_KEY <value>
#   npx convex env set TURNSTILE_SECRET_KEY <value>
