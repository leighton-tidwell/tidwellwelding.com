{
  "name": "codebase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "pnpm run build:cf && opennextjs-cloudflare deploy && node scripts/indexnow-ping.mjs",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:cf": "npx convex deploy -y --cmd 'node scripts/assert-production-convex-url.mjs && pnpm exec opennextjs-cloudflare build' --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL",
    "ci:build": "pnpm test && node scripts/ci-build.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@convex-dev/agent": "^0.7.9",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/resend": "^0.2.10",
    "@marsidev/react-turnstile": "^1.6.3",
    "@react-pdf/renderer": "^4.9.0",
    "ai": "^7.0.162",
    "convex": "^1.49.0",
    "lucide-react": "^1.67.0",
    "next": "16.4.5",
    "pdf-lib": "^1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.37.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@edge-runtime/vm": "^5.0.0",
    "@opennextjs/cloudflare": "^1.20.16",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "convex-test": "^0.0.55",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  },
  "packageManager": "pnpm@11.21.0"
}
